                    Icon(Icons.atm, color: petrol, size: 30),
                  ],
                ),
                const SizedBox(height: 16),
                // أزرار المكن (مبدئياً)
                Wrap(
                  spacing: 10,
                  runSpacing: 10,
                  children: [
                    _machineBtn('فوري رئيسي'),
                    _machineBtn('فوري كروت'),
                    _machineBtn('فوري كاش أوت'),
                    _machineBtn('بساطة'),
