      child: Column(
        children: [
          Text(name, style: const TextStyle(fontWeight: FontWeight.bold, color: petrol)),
          const SizedBox(height: 4),
          const Text('0', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
